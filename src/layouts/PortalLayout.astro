---
import "../styles/global.css";
import Header from "../components/PORTAL/Header.astro";
import Footer from "../components/PORTAL/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>Brooklyn Piano Studio | Student Portal</title>
	</head>

	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>

</html>

<style>
html,
body {
  background: var(--parchment);
}

body {
  margin: 0;
}

main {
  margin: 0;
  padding: 0;
}
</style>
