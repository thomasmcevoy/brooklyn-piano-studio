---
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/SITE/HOME/Home.astro';
import About from '../components/SITE/ABOUT/About.astro';
import Rates from '../components/SITE/RATES/Rates.astro';
import Contact from '../components/SITE/CONTACT/Contact.astro';
import StudentPortal from '../components/SITE/STUDENT PORTAL/StudentPortal.astro';
---

<SiteLayout>
  <Home/>
  <About/>
  <Rates/>
  <Contact/>
  <StudentPortal/>
</SiteLayout>

<style>
</style>

<script>
  const header = document.querySelector<HTMLElement>('#site-header');

  if (!header) {
    throw new Error('Expected #site-header to exist.');
  }

  function updateHeaderHeight(header: HTMLElement) {
    document.documentElement.style.setProperty(
      '--header-height',
      `${header.offsetHeight}px`
    );
  }

  updateHeaderHeight(header);

  const observer = new ResizeObserver(() => {
    updateHeaderHeight(header);
  });

  observer.observe(header);
</script>