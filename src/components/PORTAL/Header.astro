---
import Container from '../UI/Container.astro';
import Wordmark from '../UI/Wordmark.astro';
import Rule from '../UI/Rule.astro';
---

<header id="portal-header">
  <Container size="wide">
    
    <div class="header-inner">
      <a href="/" class="wordmark-container">
        <Wordmark text="Brooklyn Piano Studio" class="header-wordmark"/>
      </a>
      <a href="/" class="back-to-site">[ ← Back to Site ]</a>
    </div>

    <Rule variant="spacer" width="full" margin="zero"/>

  </Container>
</header>

<style>
#portal-header {
  width: 100%;
  background: var(--parchment);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: .375rem;
}

.wordmark-container {
  font-size: 1.8rem;
  transform: translateY(-.3rem);  /* fix wordmark vertical position  */
}

#portal-header a {
  color: var(--dark-brown-ink);
  opacity: .9;
  text-decoration: none;
}

/* @media (max-width: 450px) {
  .header-inner {
    flex-direction: column;
    align-items: center;  
    padding-block: 0;
  }
  .wordmark-container {
    transform: translateY(.6rem);  
  }
  :global(header a) {
    transform: translateY(.3rem);  
  }
} */

#portal-header .back-to-site {
  color: var(--taupe);
  opacity: .47;
  letter-spacing: .025rem;
  transform: translateY(.25rem);
}

#portal-header .back-to-site:hover {
  color: var(--dark-brown-ink);
  opacity: .9;
}
</style>