---
import Container from '../UI/Container.astro';
import SectionTitle from '../UI/SectionTitle.astro';
---

<div id="student-portal-home">
  <SectionTitle class="title">Educational materials</SectionTitle>

  <Container size="narrow">
    <p>This is where you will find various educational resources provided for your reference. This section is under construction, stay tuned!</p>
  </Container>
</div>

<style>
#student-portal-home {
  padding-block: var(--section-spacing-xl);
  background: var(--light-parchment);
  color: var(--brown-ink);
}

p {
  color: inherit;
}
</style>