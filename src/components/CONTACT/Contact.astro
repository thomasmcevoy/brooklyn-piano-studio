---
import Container from '../UI/Container.astro';
import ContactIntro from './ContactIntro.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contact">
  
  <ContactIntro/>

  <Container size="narrow">
    <ContactForm/>
  </Container>
  
</section>

<style>
#contact {
  margin: 0;
  padding-block: var(--section-spacing-xl) var(--section-spacing-md);
  background: var(--dark-parchment-2);
}

@media (max-width: 700px) {
  #contact {
    padding-block: var(--section-spacing-md);
  }
}
</style>