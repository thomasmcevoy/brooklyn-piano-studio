---
import { Image } from 'astro:assets';
import handsOnKeys from '../../assets/hands-on-keys.jpg';
import SectionTitle from '../UI/SectionTitle.astro';
import Container from '../UI/Container.astro';
import Rule from '../UI/Rule.astro';
import Grid from '../UI/Grid.astro';
---

<div class="rates-intro">

  <Container size="extra-narrow">
    <h2>Rates & Lesson&nbsp;Options</h2>
    <Rule variant="spacer"></Rule>
  </Container>

  <div class="main-content-block">
    <Container size="medium-flexible">
      <Grid variant="split">
      
        <Image
          src={handsOnKeys}
          alt="Piano student with their hands on the piano keys"
        />
      
        <div class="rates-intro-content">
          <p class="copy">We understand that every student has different goals, schedules, and experience levels, and thus we offer lessons in a variety of formats. Whether you're looking for an occasional refresher or weekly private instruction, you'll find an option tailored to your goals and lifestyle.</p>
        </div>
        
      </Grid>
    </Container>
  </div>

  <Container size="extra-narrow">
    <p class="copy">If you're unsure which format is the best fit or have needs outside what is described below, feel free to <a href="/contact/">reach out</a>. We're always happy to discuss your goals and recommend a lesson plan that's right for you.</p>
   
  </Container>
</div>

<style>
.rates-intro {
  margin: 0;
  padding-block: calc(var(--section-spacing-lg) + var(--section-spacing-lg));
  background: var(--dark-parchment-2);
  color: var(--dark-brown-ink);

  /* min-height: calc(105vh - var(--header-height)); */
  display: grid;
  align-content: center;
}

.rates-intro h2 {
  margin-bottom: -1rem;
    text-align: center;
  }

@media (max-width: 700px) {
  .rates-intro {
    padding-top: var(--section-spacing-md);
    padding-bottom: calc(var(--section-spacing-md) + var(--space-sm));
  }
}

.main-content-block {
  margin-bottom: 2.1rem;
}

.rates-intro-content {
  align-self: center;
}

h2 span {
  /* font-family: 'Gill Sans Condensed'; */
  font-size: 130%;
  font-weight: 400;
  margin-inline: .3em;
}

.rates-intro-content p:last-of-type {
  margin-bottom: 0;
}

h2,
p {
  color: var(--dark-brown-ink);
}

a {
  color: var(--bright-gold);
}

a:hover {
  color: var(--bright-gold-hover);
}
</style>