---
import { Image } from 'astro:assets';
import handsOnKeys from '../../assets/hands-on-keys.jpg';
import Container from '../UI/Container.astro';
import Rule from '../UI/Rule.astro';
import Grid from '../UI/Grid.astro';
---

<div id="rates-intro">

  <Container size="extra-narrow">
    <h2>Rates & Lesson&nbsp;Options</h2>
    <Rule variant="spacer"></Rule>
  </Container>

  <Container size="medium-flexible">
    <Grid variant="split">
    
      <div class="split-image">
        <Image
          src={handsOnKeys}
          alt="Piano student with their hands on the piano keys"
        />
      </div>
    
      <div class="content">
        <p class="copy">We understand that each student has their own unique goals, schedule, and learning style, and that's why we offer lessons in a variety of formats. Whether you're looking for an occasional refresher or weekly private instruction, you'll find an option tailored to suit your goals and lifestyle.</p>
      </div>
      
    </Grid>
  </Container>

  <Container size="extra-narrow">
    <Rule variant="spacer"></Rule>

    <p class="prose reach-out">If you're unsure which format is the best fit or have needs outside what is described, feel free to <a href="/#contact">reach out</a>. We're always happy to discuss your situation and work with you to design a lesson plan that's a perfect fit.</p>
   
  </Container>
</div>

<style>
#rates-intro {
  margin: 0;
  padding-top: calc(var(--section-spacing-xl) + var(--space-xs));
  padding-bottom: calc(var(--section-spacing-lg) + var(--space-xs));
  background: var(--dark-parchment-2);
  color: var(--dark-brown-ink);

  display: grid;
  align-content: center;
}

#rates-intro h2 {
    margin-bottom: -1rem;
    text-align: center;
  }

@media (max-width: 700px) {
  #rates-intro {
    padding-top: var(--section-spacing-md);
    padding-bottom: calc(var(--section-spacing-md) + var(--space-sm));
  }

  #rates-intro .content {
    order: -1;
  }
}

.split-image {
  height: 100%;
  overflow: hidden;
}

.split-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#rates-intro .content {
  align-self: center;
}

#rates-intro p {
  margin-block: 0;
}

#rates-intro p.reach-out {
  margin-top: -.5rem;
  margin-inline: auto;
  width: 19.25rem;
}

h2,
p {
  color: var(--dark-brown-ink);
}

a {
  color: var(--bright-gold);
}

a:hover {
  color: var(--bright-gold-hover);
}
</style>