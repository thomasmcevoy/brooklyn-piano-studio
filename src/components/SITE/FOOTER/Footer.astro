---
import Container from '../../UI/Container.astro';
import Wordmark from '../../UI/Wordmark.astro';
import Grid from '../../UI/Grid.astro';
import Cta from '../../UI/Cta.astro';
import Nav from './Nav.astro';
import Blurb from './Blurb.astro';
---

<footer id="site-footer">
  <Container size="medium-flexible">
    
    <div class="wordmark-container">
      <Wordmark text="Brooklyn Piano Studio" />
    </div>

    <Grid variant="footer">
      
      <Blurb />
      <Nav />
      <Cta 
        text="Ready to get started?"
        buttonText="BOOK A LESSON"
        variant="footer"
      />
      
    </Grid>

    <p class="copyright">
      <small>&copy; 2026 Brooklyn Piano Studio. All rights reserved.</small>
    </p>
  </Container>
</footer>

<style>
#site-footer {
  padding-top: calc(var(--section-spacing-md) + var(--space-sm));
  padding-bottom: var(--space-lg);
  background-color: var(--site-background-color);
}

@media (max-width: 700px) {
  #site-footer {
    padding-top: calc(var(--section-spacing-sm) + var(--space-md));
    padding-bottom: var(--space-xs);
  }
}

.wordmark-container {
  position: relative;
  padding-bottom: .375rem;
  border-bottom: 1px solid rgba(232, 221, 207, 0.2);
  text-align: center;
  color: var(--slate-text);
  font-size: 1.5rem;
  letter-spacing: .1rem;
  opacity: .8;
}

.copyright {
  margin-top: calc(var(--section-spacing-md) + var(--space-sm));
  text-align: center;
  font-style: italic;
  color: var(--slate-text-dark);
  letter-spacing: .01rem;
}

@media (max-width: 700px) {
  .copyright {
    margin-top: calc(var(--section-spacing-sm) + var(--space-sm));
  }
}

</style>