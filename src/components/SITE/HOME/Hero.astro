---
import Cta from '../../UI/Cta.astro';
import { Image } from "astro:assets";
import heroImage from "../../../assets/hero2.jpg";
---

<div id="hero">

  <Image
    src={heroImage}
    alt="Image of student playing the piano"
    class="hero-image"
  />

  <div class="content">
    <h1>Private piano lessons<br/>in Brooklyn</h1>
    <Cta
      variant="hero"
      text="Individualized instruction for all ages and skill levels, tailored to your goals."
      buttonText="Schedule your first lesson"
    />
  </div>

</div>

<style>
#hero {
  position: relative;
  min-height: max(100svh, 700px);
  overflow: hidden;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

#hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgb(0 0 0 / 0.35);
  z-index: 1;
}

#hero .content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: clamp(1.5rem, 3vh, 3rem);
  /* transform: translateY(-3vh); */
  z-index: 2;
}

#hero h1 {
  text-align: center;
  color: var(--parchment);
  font-size: clamp(2rem, 6vw, 2.7rem);
}
</style>