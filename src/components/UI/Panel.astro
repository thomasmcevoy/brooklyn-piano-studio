---
const {
  variant = "",
  class: className = ""
} = Astro.props;
---

<article class={`panel ${variant} ${className}`}>
  <slot />
</article>

<style is:global>
.panel {
  background: inherit;
  padding: .75rem 0;
  box-shadow: none;
}

@media (max-width: 900px) {
  .panel {
    width: min(100%, 16rem);
    min-width: 0;
  }
}

@media (min-width: 701px) and (max-width: 900px) {
  .panel.standalone {
    grid-column: 1 / -1;
    width: min(100%, 21rem);
    margin-inline: auto;
  }
  :global(.overview .panel.standalone) {
    width: min(100%, 23rem);
  }
  :global(.overview .panel.standalone h3) {
    font-size: 1.45rem;
  }
  :global(.overview .panel.standalone h4) {
    font-size: 1.3rem;
  }
  :global(.overview .panel.standalone p) {
    font-size: 1.2rem;
  }
}

@media (max-width: 700px) {
  .panel {
    margin-block: .2rem;
  }
}

.panel p,
.panel h3,
.panel li {
  color: var(--parchment);
}

.panel h3 {
  position: relative;
  display: inline-block;
  width: 100%;
  padding: .25em 0;
  margin-bottom: 1.25em;
  font-size: 1.2rem;
  letter-spacing: .05em;
}

.panel h3::after {
  content: "";
  position: absolute;

  left: -1rem;
  right: -1rem;

  bottom: 0;
  height: .135rem;

  background: var(--gold);
}

.panel h4 {
  font-style: italic;
  font-weight: 700;
  color: var(--extra-dark-parchment);
}

.panel ul {
  padding-inline-start: 0;
}


/* -------------------- Decorated list items -------------------- */
.panel ul.decorated {
  list-style: none;
  padding: 0;
}

.panel ul.decorated li {
  position: relative;
  padding-left: 1rem;
  margin-bottom: .75rem;
}

.panel ul.decorated li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .55em;

  width: .3rem;
  height: .3rem;

  background: var(--gold);
  transform: rotate(45deg);
}
</style>