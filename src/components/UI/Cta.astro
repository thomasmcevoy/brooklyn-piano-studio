---
import Button from './Button.astro';

const {
  text,
  buttonText,
  variant,
  href = "/#contact",
} = Astro.props;
---

<div class={`cta ${variant}`}>
  <p>{text}</p>
  <Button 
    href={href} 
    text={buttonText} 
    variant={variant}
  />
</div>

<style>
.cta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.cta p {
  margin-bottom: 1rem;
  font-style: italic;
}


/* --------------- Hero variant --------------- */
.cta.hero {
  width: 100%;
  text-align: center;
}

.cta.hero p {
  font-style: italic;
  color: var(--parchment);
  text-wrap: balance;
}


/* --------------- About variant --------------- */
.cta.about p {
  color: var(--brown-ink);
}



/* --------------- Footer variant --------------- */
.cta.footer {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.cta.footer p {
  color: var(--footer-text-bright);
  font-style: normal;
}

@media (max-width: 700px) {
  .cta.footer {
    grid-column: 1 / -1;
  }
}
</style>