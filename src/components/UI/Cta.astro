---
import Button from './Button.astro';

const {
  text,
  buttonText,
  variant,
  href = "/#contact",
} = Astro.props;
---

<div class={`cta ${variant}`}>
  <p>{text}</p>
  <Button 
    href={href} 
    text={buttonText} 
    variant={variant}
  />
</div>

<style>
.cta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.cta p {
  margin-bottom: 1rem;
}


/* --------------- Hero variant --------------- */
.cta.hero {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translateX(-50%);
  width: 100%;
  text-align: center;
  z-index: 3;
}

.cta.hero p {
  font-style: italic;
  color: var(--parchment);
  text-wrap: balance;
}


/* --------------- About variant --------------- */
/* @media (min-width: 701px) {
  .cta.about {
    padding-top: var(--space-sm);
  }
} */

.cta.about p {
  font-style: italic;
  color: var(--brown-ink);
}



/* --------------- Rates Intro variant --------------- */
/* @media (min-width: 701px) {
  .cta.about {
    padding-top: var(--space-sm);
  }
} */

.cta.rates-intro {
  margin-top: calc(var(--space-xs) + var(--space-md));
}

.cta.rates-intro p {
  margin-bottom: 1.35rem;
  font-style: italic;
  color: var(--brown-ink);
}



/* --------------- Footer variant --------------- */
.cta.footer {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.cta.footer p {
  color: var(--footer-text-bright)
}

@media (max-width: 700px) {
  .cta.footer {
    grid-column: 1 / -1;
  }
}
</style>