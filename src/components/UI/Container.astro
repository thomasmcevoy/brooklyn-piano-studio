---
const {
  size,
  aligned
} = Astro.props;
---

<div class={`container ${size} ${aligned}`}>
  <slot />
</div>

<style>
.container {
  width: min(100% - clamp(2rem, 8vw, 5rem), var(--max-width));
  margin-inline: auto;
  padding-inline: 0;
}

.container.wide {
  --max-width: 64rem;
}

.container.medium-flexible {
  --max-width: clamp(400px, calc(75vw + 4rem), 1000px);
}

.container.narrow {
  --max-width: 60ch;
}

.container.medium-narrow {
  --max-width: 54ch;
}

.container.extra-narrow {
  --max-width: 48ch;
}

.container.left {
  text-align: left;
  margin-left: 0;
}
</style>