---
const {
  variant,
  width = "normal",
  margin = "normal"
} = Astro.props;
---

<div class={`rule ${variant} ${width}-width ${margin}-margin`} aria-hidden="true"></div>

<style>
.rule {
  margin-inline: auto;
}

.rule.normal-width {
  width: 75%;
}

.rule.full-width {
  width: 100%;
}

@media (max-width: 500px) {
  .rule.normal-width {
    width: calc(75% + (500px - 100vw) * 0.25);
  }
}



/* ----------- section-title variant ---------- */
.rule.section-title {
  height: .09rem;
  background: rgba(255, 255, 255, .08);
}
:global(.rates-intro .rule.section-title) {
  height: .9px;
  background: var(--muted-warm-gray);
}



/* -------------- footer variant -------------- */
.rule.wordmark {
  margin-top: .375rem;
  height: 1px;
  background: rgba(232, 221, 207, 0.2);
}



/* -------------- spacer variant -------------- */
.rule.spacer {
  height: 1px;
  background: #b4ab9e;
}

.rule.spacer.normal-margin {
  margin-block: var(--section-spacing-sm);
}

.rule.spacer.zero-margin {
  margin-block: 0;
}

@media (max-width: 700px) {
  .rule.spacer.normal-margin {
    margin-block: var(--space-lg);
  }
}
</style>