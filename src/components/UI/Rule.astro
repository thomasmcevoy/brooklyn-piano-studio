---
const { variant } = Astro.props;
---

<div class={`rule ${variant}`} aria-hidden="true"></div>

<style>
.rule {
  margin-inline: auto;
  width: 75%;
}

@media (max-width: 500px) {
  .rule {
    width: calc(75% + (500px - 100vw) * 0.25);
  }
}

/* ----------- section-title variant ---------- */
.rule.section-title {
  height: .05rem;
  background: #b4ab9e;
}

.rule.instructor-bio .rule.section-title {
  background: var(--gold);
}


/* -------------- footer variant -------------- */
.rule.wordmark {
  margin-top: .375rem;
  height: 1px;
  background: rgba(232, 221, 207, 0.2);
}


/* -------------- spacer variant -------------- */
.rule.spacer {
  height: 1px;
  margin-block: var(--space-lg);
  background: #b4ab9e;
}

@media (max-width: 700px) {
  .rule.spacer {
    margin-block: var(--space-md);
  }
}
</style>